# BotFather'dan olingan token
BOT_TOKEN=123456:ABC-DEF...

# Database sifatida ishlatiladigan Telegram guruh ID'si (bot shu guruhga admin
# qilib qo'shilgan bo'lishi va xabar pin qila olishi kerak).
# ID odatda -100 bilan boshlanadi, masalan: -1001234567890
DB_GROUP_ID=-1001234567890

# Superadmin Telegram user ID'si (bitta bo'lsa shu yetarli)
SUPERADMIN_ID=123456789
# Bir nechta teng huquqli superadmin kerak bo'lsa, buni ishlating (vergul bilan):
# SUPERADMIN_IDS=123456789,987654321

# Groq API kaliti (https://console.groq.com/keys) - prompt preprocessing uchun
GROQ_API_KEY=gsk_...
# Ixtiyoriy: standart llama-3.3-70b-versatile o'rniga boshqa model
# GROQ_MODEL=llama-3.1-8b-instant
